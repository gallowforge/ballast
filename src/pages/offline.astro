---
import Base from '@/layouts/Base.astro';
import Logo from '@/components/frame/Logo.astro';
import { url } from '@/lib/site';
---

<Base title="Offline" noindex>
  <main class="mx-auto grid min-h-dvh max-w-md place-items-center px-6 text-center">
    <div>
      <Logo />
      <h1 class="display mt-8 text-4xl">You are offline</h1>
      <p class="mt-3 text-muted">
        This page was not saved for offline use yet. Everything else in Ballast works without a
        connection, and your data is safe on this device.
      </p>
      <a href={url('home/')} class="btn btn-primary mt-6">
        Open Ballast
      </a>
    </div>
  </main>
</Base>
