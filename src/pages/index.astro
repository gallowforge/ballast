---
import Base from '@/layouts/Base.astro';
import SiteHeader from '@/components/frame/SiteHeader.astro';
import SiteFooter from '@/components/frame/SiteFooter.astro';
import { Money } from '@/components/ui/Money';
import { RoadView, roadHorizon } from '@/components/charts/RoadView';
import { buildDemo } from '@/lib/demo';
import { formatMonth, formatShort, plural, today as todayISO } from '@/lib/dates';
import { cycleSummary } from '@/lib/calc/cycle';
import { runway } from '@/lib/calc/runway';
import { formatMinor, formatMoney } from '@/lib/money/money';
import { currency } from '@/lib/money/currency';
import { mappingFor, readStatement, sourceFromCSV } from '@/lib/import/importer';
import { cleanPayee } from '@/lib/import/clean';
import sample from '../../public/samples/sample-statement.csv?raw';
import { url } from '@/lib/site';

// Everything below is the real engine, run on the made-up demo and the sample statement at build
// time. No dates are written into the copy: they come from the engine.
const today = todayISO();
const demo = buildDemo(today);
const s = cycleSummary(demo, today);
const r = runway(demo, today);
const horizon = roadHorizon(today, r.runOut, r.target?.date);
const base = demo.settings.base;
const source = sourceFromCSV(sample, 'sample-statement.csv');
const sampleCurrency = source.currency ?? base;
const exp = currency(sampleCurrency).exp;
const statement = readStatement(source, mappingFor(source), sampleCurrency);
const lines = statement.rows.slice(1, 8);
const rec = statement.reconciliation;
---

<Base description="Ballast is a calm, private money app. Pay yourself a monthly salary from your savings, see how far it carries you, and read bank statements on your own device.">
  <SiteHeader />
  <main id="main">
    <section class="mx-auto max-w-6xl px-5 pt-14 sm:px-8 lg:pt-24">
      <h1
        class="display max-w-[14ch] text-[3.3rem] animate-rise sm:text-[5.6rem] lg:text-[6.6rem]"
        style="animation-delay: 60ms"
      >
        Pay yourself a salary that <em class="text-gold-ink">lasts.</em>
      </h1>
      <div
        class="mt-8 grid gap-8 animate-rise lg:grid-cols-[1fr_auto] lg:items-end"
        style="animation-delay: 120ms"
      >
        <p class="serif max-w-[42ch] text-[1.35rem] leading-snug text-muted italic">
          Ballast turns your savings into a monthly salary, tells you what is safe to spend today,
          and draws how far the money carries you. Your bank statements are read on your own device,
          and nothing ever leaves it.
        </p>
        <div class="flex flex-wrap items-center gap-5">
          <a href={url('home/')} class="btn btn-primary">
            Open Ballast
          </a>
          <a href={url('home/?demo=1')} class="link">
            Look around with made-up money
          </a>
        </div>
      </div>
    </section>

    <section
      class="mx-auto mt-14 max-w-6xl px-5 sm:px-8"
      aria-label={`A road drawn from the demo: the savings of Alex, who is made up, last until ${formatMonth(r.lastFull ?? today)}.`}
    >
      <div class="relative">
        <div class="hidden md:block" aria-hidden="true">
          <RoadView
            today={today}
            horizon={horizon}
            runOut={r.runOut}
            lastFull={r.lastFull}
            target={r.target}
            start={r.start}
            code={base}
            height={430}
            fallbackWidth={1104}
            spread={0.36}
          />
        </div>
        <div class="md:hidden" aria-hidden="true">
          <RoadView
            today={today}
            horizon={horizon}
            runOut={r.runOut}
            lastFull={r.lastFull}
            target={r.target}
            start={r.start}
            code={base}
            height={230}
            compact
            fallbackWidth={350}
          />
        </div>
      </div>
      <p class="mt-4 flex flex-wrap items-baseline justify-between gap-2 border-t border-line pt-3 text-sm text-subtle">
        <span>
          <span class="serif text-[1.05rem] text-fg italic">
            Alex’s savings last until {formatMonth(r.lastFull ?? today)},
          </span>
          {plural(r.periods, 'salary', 'salaries')} of {formatMoney(r.monthly, base)}.
        </span>
        <span>Alex is made up. The road is drawn by the same engine you get.</span>
      </p>
    </section>

    <section
      class="mx-auto mt-28 grid max-w-6xl gap-12 px-5 sm:px-8 lg:grid-cols-[1.1fr_1fr] lg:gap-20"
      aria-labelledby="today-title"
    >
      <div>
        <h2 id="today-title" class="display text-[2.4rem] sm:text-[3.2rem]">
          <span
            class="figure mr-3 align-top text-[0.62em] text-gold-ink sm:absolute sm:-ml-14 sm:mr-0"
            aria-hidden="true"
          >
            1
          </span>
          A month you can read in one number.
        </h2>
        <p class="mt-5 max-w-[46ch] text-[1.05rem] text-muted">
          On payday Ballast moves your salary from savings to spending. It keeps the bills still to
          come aside, divides what is left by the days left, and gives you the answer: what you can
          spend today and still finish the month calmly.
        </p>
        <p class="figure mt-10 text-[5rem] sm:text-[6.5rem]">
          <Money value={s.perDay} code={base} />
        </p>
        <p class="serif mt-3 max-w-[30ch] text-[1.2rem] text-muted italic">
          is Alex’s to spend today, and the month still ends calmly.
        </p>
      </div>
      <div class="lg:pt-24">
        <div class="border-b-2 border-fg pb-2">
          <span class="serif text-[1.45rem] font-[480]">This month</span>
        </div>
        <dl>
          <div class="flex items-baseline justify-between border-b border-line py-3">
            <dt>Salary, from savings</dt>
            <dd class="text-[1.15rem]">
              <Money value={s.allowance} code={base} sign="always" tone="income" />
            </dd>
          </div>
          <div class="flex items-baseline justify-between border-b border-line py-3">
            <dt>
              Spent so far <span class="ml-1 text-sm text-subtle">{plural(s.daysGone, 'day')}</span>
            </dt>
            <dd class="text-[1.15rem]">
              <Money value={-s.spent} code={base} />
            </dd>
          </div>
          <div class="flex items-baseline justify-between border-b border-line py-3">
            <dt>
              Bills still to come <span class="ml-1 text-sm text-subtle">kept aside</span>
            </dt>
            <dd class="text-[1.15rem]">
              <Money value={-s.billsAhead} code={base} />
            </dd>
          </div>
          <div class="rule-double flex items-baseline justify-between py-3">
            <dt class="font-bold">
              Free to spend{' '}
              <span class="ml-1 text-sm font-normal text-subtle">
                over {plural(s.daysLeft, 'day')}
              </span>
            </dt>
            <dd class="text-[1.4rem] font-[540]">
              <Money value={s.safe} code={base} />
            </dd>
          </div>
        </dl>
        <p class="mt-5 text-sm text-subtle">
          Budgets keep their own lines, with a brass tick where an even pace would be today. Fixed
          bills never count as overspending.
        </p>
      </div>
    </section>

    <section class="mx-auto mt-32 max-w-6xl px-5 sm:px-8" aria-labelledby="statement-title">
      <div class="grid gap-10 lg:grid-cols-[1fr_1.5fr] lg:gap-16">
        <div>
          <h2 id="statement-title" class="display text-[2.4rem] sm:text-[3.2rem]">
            <span
              class="figure mr-3 align-top text-[0.62em] text-gold-ink sm:absolute sm:-ml-14 sm:mr-0"
              aria-hidden="true"
            >
              2
            </span>
            Every line, checked against the bank.
          </h2>
          <p class="mt-5 max-w-[42ch] text-[1.05rem] text-muted">
            Drop in a PDF or CSV. Common layouts are recognised on their own, password-protected
            PDFs open right here, and any other bank works by matching columns. Then each line’s
            balance has to follow from the one before. When they all do, nothing was misread, and
            Ballast says so.
          </p>
          <p class="serif mt-6 text-[1.25rem] text-good italic">
            All {rec.checked} lines of the sample statement agree, to the last cent.
          </p>
          <p class="mt-2 text-sm text-subtle">
            Import the same statement twice and nothing doubles. Every import undoes in one tap.
          </p>
        </div>
        <div
          class="card margin-rule overflow-x-auto py-5 pr-5 pl-[4.25rem]"
          tabindex="0"
          role="region"
          aria-label="Statement excerpt, scrolls sideways on small screens"
        >
          <div role="table" aria-label="An excerpt of the sample statement, as Ballast reads it">
            <div
              role="row"
              class="caps grid grid-cols-[3.2rem_1fr_6rem_6.5rem] gap-3 border-b border-line-strong pb-2 text-[0.68rem]"
            >
              <span role="columnheader">Date</span>
              <span role="columnheader">Payee</span>
              <span role="columnheader" class="text-right">
                Amount
              </span>
              <span role="columnheader" class="text-right">
                Balance
              </span>
            </div>
            {lines.map((l) => (
              <div
                role="row"
                class="grid grid-cols-[3.2rem_1fr_6rem_6.5rem] items-baseline gap-3 border-b border-line py-2.5"
              >
                <span role="cell" class="caps relative text-[0.68rem]">
                  <span
                    class="absolute -left-[2.6rem] text-[0.95rem] font-bold text-gold"
                    aria-hidden="true"
                  >
                    ✓
                  </span>
                  {formatShort(l.date, l.date)}
                </span>
                <span role="cell" class="truncate font-bold">
                  {cleanPayee(l.description)}
                </span>
                <span
                  role="cell"
                  class={`money text-right text-[1.05rem] ${l.amount > 0 ? 'text-good' : ''}`}
                >
                  {formatMinor(l.amount, exp, { sign: l.amount > 0 ? 'always' : 'auto' })}
                </span>
                <span role="cell" class="money text-right text-[1.05rem] text-muted">
                  {l.balance !== undefined ? formatMinor(l.balance, exp) : ''}
                  <span class="sr-only">, checked</span>
                </span>
              </div>
            ))}
          </div>
          <p class="pt-3 text-xs text-subtle">
            From a made-up statement shipped with Ballast. Card numbers and terminal codes are
            tidied away automatically.
          </p>
        </div>
      </div>
    </section>

    <section
      class="mx-auto mt-32 grid max-w-6xl gap-12 px-5 sm:px-8 lg:grid-cols-[1.1fr_1fr] lg:gap-20"
      aria-labelledby="private-title"
    >
      <div>
        <h2 id="private-title" class="display text-[2.4rem] sm:text-[3.2rem]">
          <span
            class="figure mr-3 align-top text-[0.62em] text-gold-ink sm:absolute sm:-ml-14 sm:mr-0"
            aria-hidden="true"
          >
            3
          </span>
          It cannot phone home.
        </h2>
        <p class="mt-5 max-w-[46ch] text-[1.05rem] text-muted">
          Every page carries one line that tells the browser Ballast may only talk to itself. There
          is no account to make, no server holding your money, no analytics and no exchange-rate
          service. Once you have opened it, it works with no connection at all.
        </p>
        <p class="serif mt-8 inline-block border-b-2 border-gold pb-1 text-[1.6rem] sm:text-[2rem]">
          connect-src 'self'
        </p>
      </div>
      <div class="lg:pt-24">
        <div class="border-b-2 border-fg pb-2">
          <span class="serif text-[1.45rem] font-[480]">What it asks of you</span>
        </div>
        <dl>
          <div class="flex items-baseline justify-between border-b border-line py-3">
            <dt>Accounts to create</dt>
            <dd class="figure text-[1.6rem]">0</dd>
          </div>
          <div class="flex items-baseline justify-between border-b border-line py-3">
            <dt>Servers holding your data</dt>
            <dd class="figure text-[1.6rem]">0</dd>
          </div>
          <div class="flex items-baseline justify-between border-b border-line py-3">
            <dt>Trackers, ads and analytics</dt>
            <dd class="figure text-[1.6rem]">0</dd>
          </div>
          <div class="rule-double flex items-baseline justify-between py-3">
            <dt class="font-bold">Things that leave your device</dt>
            <dd class="figure text-[2.2rem] text-gold-ink">0</dd>
          </div>
        </dl>
        <p class="mt-5 text-sm text-subtle">
          Export everything as one file, restore it on another device, or delete it all with one
          button.
        </p>
      </div>
    </section>

    <section class="mx-auto mt-32 max-w-6xl px-5 sm:px-8" aria-labelledby="diff-title">
      <h2 id="diff-title" class="display max-w-[20ch] text-[2.4rem] sm:text-[3.2rem]">
        Made for living on savings.
      </h2>
      <p class="mt-4 max-w-[52ch] text-[1.05rem] text-muted">
        Most money apps assume a paycheck and a bank login. Ballast starts from what you have and
        the date you need it to reach.
      </p>
      <div
        class="mt-10 overflow-x-auto"
        tabindex="0"
        role="region"
        aria-label="Comparison, scrolls sideways on small screens"
      >
        <table class="w-full min-w-[34rem] text-left">
          <caption class="sr-only">Ballast compared with typical money apps</caption>
          <thead>
            <tr class="caps border-b-2 border-fg text-[0.7rem]">
              <th class="py-2 pr-4 font-bold"></th>
              <th class="py-2 pr-4 font-bold text-fg">Ballast</th>
              <th class="py-2 font-bold">Typical apps</th>
            </tr>
          </thead>
          <tbody>
            {[
              ['Account', 'None', 'Required'],
              ['Your data', 'On your device only', 'On their servers'],
              [
                'Bank statements',
                'Read here, checked line by line',
                'A bank login handed to a third party',
              ],
              ['Living on savings', 'A salary, a runway and a date', 'Not modelled'],
              [
                'Money maths',
                'Exact to the smallest unit, even three decimals',
                'Often floats, often two decimals',
              ],
              ['With no connection', 'Everything works', 'Read-only, or nothing'],
              ['Price', 'Free and open source', 'A subscription'],
            ].map(([k, a, b]) => (
              <tr class="border-b border-line">
                <th class="py-3.5 pr-4 font-bold">{k}</th>
                <td class="serif py-3.5 pr-4 text-[1.1rem]">{a}</td>
                <td class="py-3.5 text-subtle">{b}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="mx-auto mt-32 max-w-6xl px-5 sm:px-8">
      <div class="grid gap-8 border-t-2 border-fg pt-10 lg:grid-cols-[1fr_auto] lg:items-end">
        <div>
          <h2 class="display text-[2.6rem] sm:text-[3.6rem]">Start in a minute.</h2>
          <p class="serif mt-3 text-[1.25rem] text-muted italic">
            Two balances, a salary and a date. Or bring in a statement and let the past months fill
            in.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-5">
          <a href={url('home/')} class="btn btn-primary">
            Open Ballast
          </a>
          <a href={url('about/')} class="link">
            How it works
          </a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
