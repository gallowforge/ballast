---
import Base from '@/layouts/Base.astro';
import Logo from '@/components/frame/Logo.astro';
import { url } from '@/lib/site';
---

<Base title="Not found" noindex>
  <main class="mx-auto grid min-h-dvh max-w-md place-items-center px-6 text-center">
    <div>
      <Logo />
      <h1 class="display mt-8 text-4xl">Nothing here</h1>
      <p class="mt-3 text-muted">That page does not exist. Your data is untouched.</p>
      <div class="mt-6 flex justify-center gap-2">
        <a href={url('home/')} class="btn btn-primary">
          Open Ledger
        </a>
        <a href={url()} class="btn btn-soft">
          About Ledger
        </a>
      </div>
    </div>
  </main>
</Base>
