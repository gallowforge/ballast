---
import Base from './Base.astro';
import SiteHeader from '@/components/frame/SiteHeader.astro';
import SiteFooter from '@/components/frame/SiteFooter.astro';
interface Props {
  title: string;
  description: string;
  lead: string;
  eyebrow?: string;
}
const { title, description, lead } = Astro.props;
---

<Base title={title} description={description}>
  <SiteHeader />
  <main id="main" class="mx-auto max-w-3xl px-5 pt-16 sm:px-8 lg:pt-24">
    <h1 class="display animate-rise text-[3rem] sm:text-[4.4rem]">{title}</h1>
    <p
      class="serif animate-rise mt-5 max-w-[40ch] text-[1.4rem] leading-snug text-muted italic"
      style="animation-delay: 60ms"
    >
      {lead}
    </p>
    <article class="prose-ledger mt-12 border-t-2 border-fg pt-2">
      <slot />
    </article>
  </main>
  <SiteFooter />
</Base>
