---
import Base from './Base.astro';
import SiteHeader from '@/components/frame/SiteHeader.astro';
import SiteFooter from '@/components/frame/SiteFooter.astro';
interface Props {
  title: string;
  description: string;
  lead: string;
  eyebrow: string;
}
const { title, description, lead, eyebrow } = Astro.props;
---

<Base title={title} description={description}>
  <SiteHeader />
  <main id="main" class="mx-auto max-w-3xl px-4 pt-14 sm:px-6">
    <p class="pill pill-gold">{eyebrow}</p>
    <h1 class="display mt-4 text-[2.8rem] sm:text-[3.4rem]">{title}</h1>
    <p class="mt-4 text-xl text-muted">{lead}</p>
    <article class="prose-ledger mt-6">
      <slot />
    </article>
  </main>
  <SiteFooter />
</Base>
