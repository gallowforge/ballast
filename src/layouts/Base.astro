---
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';
import { SITE, url } from '@/lib/site';
import sans from '../../node_modules/@fontsource-variable/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-wght-normal.woff2?url';
import serif from '../../node_modules/@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  section?: string;
  noindex?: boolean;
}
const { title, description = SITE.description, section = 'home', noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name}: ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL(url('og.png'), Astro.site);
---

<!doctype html>
<html lang="en" data-section={section} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
    />
    <meta name="referrer" content="no-referrer" />
    <link rel="preload" href={sans} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serif} as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f2ecdf" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('favicon.ico')} sizes="32x32" />
    <link rel="apple-touch-icon" href={url('icons/apple-touch-icon.png')} />
    <link rel="manifest" href={url('manifest.webmanifest')} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Ballast" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      (() => {
        const apply = () => {
          let t = null;
          try {
            t = localStorage.getItem('ledger:theme'); // the stored name predates the rename to Ballast
          } catch {}
          const dark =
            t === 'dark' || (t !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.dataset.theme = dark ? 'dark' : 'light';
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute('content', dark ? '#121d18' : '#f2ecdf');
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
        matchMedia('(prefers-color-scheme: dark)').addEventListener('change', apply);
      })();
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <slot />
  </body>
</html>
