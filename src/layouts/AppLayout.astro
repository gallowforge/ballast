---
import Base from './Base.astro';
import Logo from '@/components/frame/Logo.astro';
import Icon from '@/components/ui/Icon.astro';
import ThemeToggle from '@/components/frame/ThemeToggle.astro';
import Shell from '@/components/shell/Shell';
import { NAV, NAV_MORE, url } from '@/lib/site';

interface Props {
  title: string;
  description?: string;
  section: string;
  /** The floating add button (phones). Off where it would cover the page's own actions. */
  fab?: boolean;
}
const { title, description, section, fab = true } = Astro.props;
---

<Base title={title} description={description} section={section}>
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[90] focus:rounded-xl focus:bg-raised focus:px-4 focus:py-2"
    >Skip to content</a
  >
  <nav class="rail" aria-label="Main" transition:name="rail">
    <a href={url()} class="mb-7 px-2.5 pt-1" aria-label="Ledger home"><Logo /></a>
    <div class="grid gap-1">
      {
        NAV.map((n) => (
          <a href={url(n.href)} class="nav-item" aria-current={n.section === section ? 'page' : undefined}>
            <span class="nav-ico">
              <Icon name={n.icon} size={18} />
            </span>
            {n.label}
          </a>
        ))
      }
    </div>
    <div class="mt-auto grid gap-1">
      {
        NAV_MORE.map((n) => (
          <a href={url(n.href)} class="nav-item" aria-current={n.section === section ? 'page' : undefined}>
            <span class="nav-ico">
              <Icon name={n.icon} size={18} />
            </span>
            {n.label}
          </a>
        ))
      }
      <div class="mt-3 flex items-center gap-2 rounded-2xl border border-line px-3 py-2.5 text-xs font-semibold text-subtle">
        <Icon name="shield" size={16} class="text-good" />
        Stays on this device
      </div>
    </div>
  </nav>

  <div class="with-rail">
    <header transition:name="topbar" class="sticky top-0 z-20 border-b border-line bg-[oklch(from_var(--bg)_l_c_h/0.78)] backdrop-blur-xl lg:border-transparent lg:bg-transparent lg:backdrop-blur-none">
      <div class="mx-auto flex h-16 max-w-6xl items-center gap-2 px-4 sm:px-6 lg:px-10">
        <a href={url()} class="lg:hidden" aria-label="Ledger home"><Logo size={30} word={false} /></a>
        <div class="ml-1 text-base font-bold lg:hidden">{title}</div>
        <div class="ml-auto flex items-center gap-1.5">
          <button type="button" class="btn btn-soft btn-sm hidden gap-2 pr-2 text-muted md:inline-flex" data-palette>
            <Icon name="search" size={16} />
            Search
            <span class="kbd">⌘K</span>
          </button>
          <button type="button" class="btn btn-ghost btn-sm btn-icon md:hidden" data-palette aria-label="Open the quick launcher">
            <Icon name="search" size={18} />
          </button>
          <a href={url('import/')} class="btn btn-ghost btn-sm btn-icon lg:hidden" aria-label="Import a statement"><Icon name="upload" size={18} /></a>
          <a href={url('settings/')} class="btn btn-ghost btn-sm btn-icon lg:hidden" aria-label="Settings"><Icon name="settings" size={18} /></a>
          <ThemeToggle />
          <button type="button" class="btn btn-gold btn-sm hidden lg:inline-flex" data-add>
            <Icon name="plus" size={16} stroke={2.4} /> Add
            <span class="kbd ml-0.5 border-[oklch(0%_0_0/0.15)] bg-[oklch(0%_0_0/0.08)] text-[var(--on-gold)]">N</span>
          </button>
        </div>
      </div>
    </header>

    <main id="main" class="mx-auto max-w-6xl px-4 pt-4 pb-36 sm:px-6 lg:px-10 lg:pb-16">
      <slot />
    </main>
  </div>

  <nav class="tabbar" aria-label="Main" transition:name="tabbar">
    {
      NAV.map((n) => (
        <a href={url(n.href)} class="tab" aria-current={n.section === section ? 'page' : undefined}>
          <span class="tab-ico">
            <Icon name={n.icon} size={20} />
          </span>
          {n.label}
        </a>
      ))
    }
  </nav>
  {
    fab && (
      <button type="button" class="fab btn-gold" transition:name="fab" data-add aria-label="Add a transaction">
        <Icon name="plus" size={26} stroke={2.4} />
      </button>
    )
  }

  <Shell client:load transition:persist="shell" />

  <script>
    import { openPalette, openTxn } from '@/lib/bus';
    const wire = () => {
      document.querySelectorAll<HTMLElement>('[data-add]').forEach((b) => (b.onclick = () => openTxn()));
      document.querySelectorAll<HTMLElement>('[data-palette]').forEach((b) => (b.onclick = () => openPalette()));
    };
    wire();
    document.addEventListener('astro:page-load', wire);
  </script>
</Base>
