---
interface Props {
  size?: number;
  word?: boolean;
  class?: string;
}
const { size = 32, word = true, class: cls = '' } = Astro.props;
---

<span class={`inline-flex items-center gap-2.5 ${cls}`}>
  <svg width={size} height={size} viewBox="0 0 40 40" aria-hidden="true">
    <rect width="40" height="40" rx="8" style="fill: var(--primary)"></rect>
    <path
      d="M5 17.5h30"
      style="stroke: var(--on-primary)"
      stroke-width="1.5"
      stroke-opacity=".55"
    ></path>
    <path
      d="M12.5 35 L18.6 17.5 M27.5 35 L21.4 17.5"
      style="stroke: var(--on-primary)"
      stroke-width="2.3"
      stroke-linecap="round"
    ></path>
    <path
      d="M20 22.3v2.4M20 28.2v3.6"
      style="stroke: var(--on-primary)"
      stroke-width="1.6"
      stroke-linecap="round"
    ></path>
    <circle cx="20" cy="17.5" r="3.6" style="fill: var(--gold)"></circle>
  </svg>
  {word && (
    <span class="serif text-[1.45rem] leading-none font-[560] tracking-[-0.01em]">Ledger</span>
  )}
</span>
