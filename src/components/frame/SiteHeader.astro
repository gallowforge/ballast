---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import Icon from '@/components/ui/Icon.astro';
import { SITE, url } from '@/lib/site';
---

<header class="sticky top-0 z-20 border-b border-line bg-bg">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-2 px-5 sm:px-8">
    <a href={url()} aria-label="Ledger home">
      <Logo size={30} />
    </a>
    <nav class="ml-auto flex items-center gap-1 text-sm font-semibold" aria-label="Site">
      <a href={url('about/')} class="btn btn-ghost btn-sm hidden sm:inline-flex">
        How it works
      </a>
      <a href={url('privacy/')} class="btn btn-ghost btn-sm hidden sm:inline-flex">
        Privacy
      </a>
      <a
        href={SITE.repo}
        class="btn btn-ghost btn-sm btn-icon"
        aria-label="Source code on GitHub"
        rel="noopener"
      >
        <Icon name="github" size={18} />
      </a>
      <ThemeToggle />
      <a href={url('home/')} class="btn btn-primary btn-sm">
        Open Ledger
      </a>
    </nav>
  </div>
</header>
