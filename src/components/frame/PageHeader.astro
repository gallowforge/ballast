---
interface Props {
  title: string;
  subtitle: string;
  icon?: string;
}
const { title, subtitle } = Astro.props;
---

<header class="mb-8 max-w-3xl animate-rise lg:mb-12">
  <h1 class="display text-[2.6rem] sm:text-[3.4rem]">{title}</h1>
  <p class="serif mt-3 text-[1.2rem] leading-snug text-muted italic">{subtitle}</p>
</header>
