---
import Logo from './Logo.astro';
import { SITE, url } from '@/lib/site';
---

<footer class="mt-24 border-t border-line">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-3 px-4 py-8 text-sm text-muted sm:px-6">
    <Logo size={24} />
    <span>Free and open source. No account, no tracking.</span>
    <nav class="ml-auto flex flex-wrap gap-x-5 gap-y-2" aria-label="Footer">
      <a class="hover:text-fg" href={url('home/')}>
        Open the app
      </a>
      <a class="hover:text-fg" href={url('about/')}>
        How it works
      </a>
      <a class="hover:text-fg" href={url('privacy/')}>
        Privacy
      </a>
      <a class="hover:text-fg" href={SITE.repo} rel="noopener">
        Source code
      </a>
    </nav>
  </div>
</footer>
