---
import Logo from './Logo.astro';
import { SITE, url } from '@/lib/site';
---

<footer class="mt-28 border-t-2 border-fg">
  <div class="mx-auto grid max-w-6xl gap-6 px-5 py-10 text-sm text-muted sm:grid-cols-[1fr_auto] sm:px-8">
    <div>
      <Logo size={26} />
      <p class="serif mt-3 max-w-sm text-[1.05rem] italic">
        Free and open source. No account, no server, nothing that leaves your device.
      </p>
    </div>
    <nav class="flex flex-wrap content-start gap-x-6 gap-y-2 font-bold" aria-label="Footer">
      <a class="tap hover:text-fg" href={url('home/')}>
        Open the app
      </a>
      <a class="tap hover:text-fg" href={url('about/')}>
        How it works
      </a>
      <a class="tap hover:text-fg" href={url('privacy/')}>
        Privacy
      </a>
      <a class="tap hover:text-fg" href={SITE.repo} rel="noopener">
        Source code
      </a>
    </nav>
  </div>
</footer>
