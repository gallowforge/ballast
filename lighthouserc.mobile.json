{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:4500/",
        "http://localhost:4500/home/",
        "http://localhost:4500/runway/",
        "http://localhost:4500/import/"
      ],
      "numberOfRuns": 2,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true
        }
      },
      "startServerCommand": "node scripts/serve.mjs dist 4500",
      "startServerReadyPattern": "Serving"
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ]
      }
    }
  }
}
