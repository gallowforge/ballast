{
  "name": "ballast",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "description": "Ballast: an offline-first money app. Pay yourself a salary from your savings, see your runway, import bank statements on the device.",
  "license": "MIT",
  "author": "Ali Husain",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "serve": "node scripts/serve.mjs dist",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "budget": "node scripts/budget.mjs",
    "fixtures": "node scripts/make-fixtures.mjs",
    "icons": "node scripts/icons.mjs",
    "readme:visuals": "bash docs/readme/src/build.sh",
    "verify": "npm run check && npm run test && npm run build && npm run budget"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@astrojs/preact": "^6.1.2",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.7",
    "pdfjs-dist": "^6.5.438",
    "preact": "^10.29.8",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@vitest/coverage-v8": "^5.1.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
