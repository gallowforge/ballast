{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:4500/",
        "http://localhost:4500/home/",
        "http://localhost:4500/activity/",
        "http://localhost:4500/plan/",
        "http://localhost:4500/runway/",
        "http://localhost:4500/insights/",
        "http://localhost:4500/import/",
        "http://localhost:4500/settings/",
        "http://localhost:4500/about/",
        "http://localhost:4500/privacy/"
      ],
      "numberOfRuns": 2,
      "settings": {
        "preset": "desktop"
      },
      "startServerCommand": "node scripts/serve.mjs dist 4500",
      "startServerReadyPattern": "Serving"
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ]
      }
    }
  }
}
